# ─────────────────────────────────────────────
# Ebee Core — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── Database ─────────────────────────────────
DB_NAME=ebee_prod
DB_URL=jdbc:postgresql://db:5432/${DB_NAME}
DB_USERNAME=ebee
DB_PASSWORD=changeme
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── JWT ──────────────────────────────────────
JWT_SECRET=your-256-bit-jwt-secret-min-32-chars-long
JWT_RESET_SECRET=your-256-bit-reset-secret-min-32-chars-long

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── File Storage (MinIO) ─────────────────────
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=https://storage.ebee.lk
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_REGION=eu-north-1
MINIO_BUCKET_NAME=your-bucket-name

# ── MinIO Root Credentials ───────────────────
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password

# ── Gmail SMTP ───────────────────────────────
APP_GMAIL_USERNAME=your-email@gmail.com
APP_GMAIL_PASSWORD=your-gmail-app-password

# ── Dialog SMS ───────────────────────────────
DIALOG_SMS_API_URL=https://api.dialog.lk
DIALOG_SMS_USERNAME=your-dialog-username
DIALOG_SMS_PASSWORD=your-dialog-password
DIALOG_SMS_AUTH_STRING=your-auth-string

# ── Super Admin ──────────────────────────────
SUPER_ADMIN_EMAIL=super@ebee.lk
SUPER_ADMIN_PASSWORD=changeme
SUPER_ADMIN_PHONE=+947xxxxxxxx

# ── Server ───────────────────────────────────
SERVER_PORT=8085

# ── CORS ─────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://ebee.lk,https://www.ebee.lk,https://catalog.ebee.lk

# ── Push Notifications ───────────────────────
NOTIFICATION_PUSH_ENABLED=false
FCM_PROJECT_ID=your-fcm-project-id
FIREBASE_CONFIG_PATH=/app/.firebase-service-account.json

# ── WhatsApp ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-wa-phone-id
WHATSAPP_ACCESS_TOKEN=your-wa-access-token
WHATSAPP_VERIFY_TOKEN=your-wa-verify-token
# Meta app secret (App settings > Basic). Required: webhook POSTs are rejected without it.
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Print Settings ───────────────────────────
PRINT_COMPANY_NAME=Kismet Plus (Pvt) Ltd
PRINT_COMPANY_ADDRESS=Vavuniya
PRINT_COMPANY_PHONE=
PRINT_COMPANY_EMAIL=
PRINT_COMPANY_REGISTRATION=

# ── IP Whitelist ─────────────────────────────
SUPER_ADMIN_IPS=
