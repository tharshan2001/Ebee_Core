Project Ebee_Core {
  database_type: 'PostgreSQL'
  Note: 'Ebee Core POS, Commission, Inventory, and Order Management System'
}

Enum order_status {
  PENDING
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

Enum payment_status {
  UNPAID
  PARTIAL
  PAID
}

Enum payment_method {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
  COD
}

Enum commission_status {
  PENDING
  CALCULATED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  ERROR
  CANCELLED
}

Enum expense_status {
  PENDING
  APPROVED
  REJECTED
}

Enum delivery_status {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
}

Enum alert_type {
  ORDER
  COMMISSION
  PAYMENT
  DELIVERY
  SYSTEM
  REMINDER
  EXPENSE
  LEAD
}

Enum period_status {
  OPEN
  CLOSED
  ARCHIVED
}

Enum combo_rule_type {
  FREE_PRODUCT
  DISCOUNT
}

Enum discount_type {
  PERCENTAGE
  FIXED
}

Enum driver_availability {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone_number varchar(20)
  role varchar(50) [not null]
  status varchar(50) [not null, default: 'ACTIVE']
  is_active boolean [not null, default: true]
  setup_token_hash varchar(255)
  refresh_token_hash varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table agents {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  agent_code varchar(50) [unique, not null]
  phone_number varchar(20)
  commission_rate numeric(10,2) [not null, default: 0.00]
  total_sales numeric(12,2) [default: 0.00]
  total_commission numeric(12,2) [default: 0.00]
  nic_number varchar(20)
  nic_document_url varchar(500)
  nic_document_name varchar(255)
  nic_document_type varchar(100)
  bank_passbook_document_url varchar(500)
  bank_passbook_document_name varchar(255)
  bank_passbook_document_type varchar(100)
  bank_account_number varchar(50)
  bank_name varchar(100)
  bank_branch varchar(100)
  address_line_1 varchar(255)
  address_line_2 varchar(255)
  city varchar(100)
  postal_code varchar(20)
  country varchar(100) [not null, default: 'Sri Lanka']
  is_active boolean [not null, default: true]
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table agent_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null]
  phone_number varchar(20) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone_number varchar(20) [unique, not null]
  email varchar(255)
  customer_code varchar(20) [unique, not null]
  book_no varchar(50) [unique]
  credit_limit decimal(12,2) [not null, default: 0.00]
  outstanding_balance decimal(12,2) [not null, default: 0.00]
  advance_balance decimal(12,2) [not null, default: 0.00]
  total_orders integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [unique, not null]
  street varchar(255)
  address_line_2 varchar(255)
  city varchar(100)
  district varchar(100)
  postal_code varchar(20)
  country varchar(100) [not null, default: 'Sri Lanka']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [unique, not null]
  slug varchar(255) [unique]
  is_active boolean [not null, default: true]
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  item_code varchar(100) [unique, not null]
  description text
  category varchar(100) [not null]
  price decimal(10,2) [not null]
  cost_price decimal(10,2) [not null]
  discount_type varchar(10)
  discount_value decimal(10,2)
  max_discount_type varchar(10)
  max_discount_value numeric(10,2)
  brand varchar(100)
  tags text
  featured boolean [not null, default: false]
  slug varchar(255) [unique]
  specifications jsonb [default: '[]']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (category) [name: 'idx_products_category']
    (is_active) [name: 'idx_products_is_active']
  }
}

Table product_images {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  image_url varchar(500) [not null]
  image_name varchar(255)
  image_type varchar(100)
  sort_order integer [default: 0]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (product_id, sort_order) [unique, name: 'uk_product_images_sort']
  }
}

Table inventory {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [unique, not null]
  quantity integer [not null, default: 0]
  reserved_quantity integer [not null, default: 0]
  reorder_level integer
  average_cost decimal(12,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table inventory_layers {
  id uuid [pk, default: `gen_random_uuid()`]
  inventory_id uuid [not null]
  quantity integer [not null]
  remaining_quantity integer [not null]
  unit_cost decimal(12,2) [not null]
  received_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (inventory_id, remaining_quantity) [name: 'idx_inventory_layers_remaining']
  }
}

Table stock {
  id uuid [pk, default: `gen_random_uuid()`]
  inventory_id uuid [not null]
  quantity_change integer [not null]
  quantity_before integer [not null, default: 0]
  quantity_after integer [not null, default: 0]
  movement_type varchar(50) [not null]
  notes text
  created_by uuid
  created_at timestamp [not null, default: `now()`]
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_number varchar(50) [unique, not null]
  agent_id uuid
  customer_id uuid
  total_amount decimal(12,2) [not null, default: 0.00]
  status varchar(50) [not null, default: 'PENDING']
  notes text
  order_source varchar(50) [not null, default: 'AGENT']
  district varchar(100)
  delivery_status varchar(50) [default: 'PENDING']
  delivery_assigned_to uuid
  delivery_scheduled_date date
  delivery_notes text
  delivery_photo_url varchar(500)
  delivery_signature_url varchar(500)
  driver_notes text
  trip_id uuid
  payment_method varchar(50)
  payment_status varchar(50) [not null, default: 'UNPAID']
  paid_amount decimal(12,2) [not null, default: 0.00]
  paid_at timestamp
  outstanding_balance decimal(12,2) [not null, default: 0.00]
  created_by uuid [not null]
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  delivered_at timestamp

  indexes {
    (status) [name: 'idx_orders_status']
    (order_number) [name: 'idx_orders_order_number']
    (payment_status) [name: 'idx_orders_payment_status']
    (delivery_status) [name: 'idx_orders_delivery_status']
    (district) [name: 'idx_orders_district']
    (trip_id) [name: 'idx_orders_trip_id']
    (customer_id) [name: 'idx_orders_customer']
  }
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid
  combo_id uuid
  quantity integer [not null]
  unit_price decimal(10,2) [not null]
  original_unit_price numeric(10,2)
  subtotal decimal(12,2) [not null]
  discount_type varchar(10)
  discount_value numeric(10,2)
  is_free_product boolean [not null, default: false]
  cost_price decimal(12,2)
  created_at timestamp [not null, default: `now()`]

  indexes {
    (combo_id) [name: 'idx_order_items_combo_id']
    (combo_id, is_free_product) [name: 'idx_order_items_combo_free']
  }
}

Table combos {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
  version integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table combo_items {
  id uuid [pk, default: `gen_random_uuid()`]
  combo_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (combo_id, product_id) [unique]
  }
}

Table combo_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  combo_id uuid [unique, not null]
  rule_type varchar(20) [not null]
  free_product_id uuid
  discount_type varchar(10)
  discount_value decimal(10,2)
  created_at timestamp [not null, default: `now()`]
}

Table drivers {
  id uuid [pk]
  user_id uuid [unique, not null]
  license_number varchar(50)
  contact_number varchar(20)
  availability varchar(50) [not null, default: 'AVAILABLE']
  fcm_token varchar(500)
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table delivery_trips {
  id uuid [pk]
  trip_date date [not null]
  district varchar(100) [not null]
  status varchar(50) [not null, default: 'PLANNED']
  assigned_driver uuid
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    (trip_date, district) [name: 'idx_trips_date_district']
  }
}

Table commission_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [unique, not null]
  commission_rate numeric(10,2) [not null]
  min_amount numeric(12,2) [default: 0.0]
  max_amount numeric(12,2)
  applies_to varchar(255) [not null]
  is_active boolean [not null, default: true]
  effective_from timestamp [not null]
  effective_to timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table commissions {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null]
  order_id uuid [not null]
  config_id uuid
  order_amount decimal(12,2) [not null]
  commission_rate decimal(5,2) [not null]
  commission_amount decimal(12,2) [not null]
  status varchar(50) [not null, default: 'PENDING']
  calculated_at timestamp
  approved_at timestamp
  paid_at timestamp
  notes text
  error_message text
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (agent_id) [name: 'idx_commissions_agent_id']
    (status) [name: 'idx_commissions_status']
    (order_id) [unique, name: 'idx_commissions_order_unique']
  }
}

Table expenses {
  id uuid [pk, default: `gen_random_uuid()`]
  category varchar(50) [not null]
  amount decimal(12,2) [not null]
  description text
  receipt_url varchar(500)
  date_incurred date [not null]
  status varchar(20) [not null, default: 'PENDING']
  created_by uuid [not null]
  driver_id uuid
  approved_by uuid
  approved_at timestamp
  rejection_reason text
  paid_at timestamp
  payment_reference varchar(255)
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table payouts {
  id uuid [pk]
  agent_id uuid [not null]
  agent_name varchar(255) [not null]
  total_amount numeric(10,2) [not null]
  status varchar(20) [not null, default: 'PENDING']
  paid_at timestamp
  pdf_url varchar(500)
  version bigint [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

Table payout_commission_ids {
  payout_id uuid [not null]
  commission_id uuid [not null]
}

Table suppliers {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  contact_person varchar(255)
  email varchar(255)
  phone varchar(20)
  address_line_1 varchar(255)
  address_line_2 varchar(255)
  city varchar(100)
  postal_code varchar(20)
  district varchar(50)
  country varchar(100) [not null, default: 'Sri Lanka']
  outstanding_balance decimal(12,2) [not null, default: 0.00]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table purchase_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  po_number varchar(50) [unique, not null]
  supplier_id uuid [not null]
  status varchar(20) [not null, default: 'DRAFT']
  total_amount decimal(12,2) [not null, default: 0]
  notes text
  payment_method varchar(50)
  payment_status varchar(50) [not null, default: 'UNPAID']
  paid_amount decimal(12,2) [not null, default: 0.00]
  outstanding_balance decimal(12,2) [not null, default: 0.00]
  paid_at timestamp
  received_at timestamp(6)
  returned_at timestamp(6)
  created_by uuid
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table purchase_order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  unit_price decimal(10,2) [not null]
  subtotal decimal(12,2) [not null]
  selling_price decimal(10,2)
  received_quantity integer
  returned_quantity integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table purchase_order_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  file_url varchar(1024) [not null]
  file_name varchar(255)
  file_type varchar(100)
  created_at timestamp [not null, default: `now()`]
}

Table leads {
  id uuid [pk]
  agent_id uuid [not null]
  agent_name varchar(255) [not null]
  customer_name varchar(255) [not null]
  phone varchar(50) [not null]
  email varchar(255)
  product_interest varchar(255) [not null]
  note text
  submitted_at timestamp [not null]
  converted_order_id uuid
  created_at timestamp
  updated_at timestamp
}

Table payments {
  id uuid [pk]
  order_id uuid [not null]
  amount decimal(12,2) [not null]
  payment_method varchar(50) [not null]
  cheque_number varchar(100)
  proof_file_url varchar(500)
  recorded_by uuid [not null]
  recorded_by_name varchar(255)
  created_at timestamp [not null, default: `now()`]
}

Table customer_advance_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  order_id uuid
  amount decimal(12,2) [not null]
  balance_after decimal(12,2) [not null]
  transaction_type varchar(30) [not null]
  reference_type varchar(30) [not null]
  reference_id uuid
  description text
  created_at timestamp [not null, default: `now()`]
}

Table messages {
  id uuid [pk]
  sent_by uuid [not null]
  subject varchar(255) [not null]
  body text [not null]
  target_type varchar(30) [not null]
  total_recipients int [not null, default: 0]
  sent_at timestamp [not null, default: `now()`]
}

Table message_recipients {
  id uuid [pk]
  message_id uuid [not null]
  recipient_type varchar(10) [not null]
  recipient_id uuid [not null]
  name varchar(255)
  phone_number varchar(20)
  email varchar(255)
  sent_sms boolean [not null, default: false]
  sent_email boolean [not null, default: false]
}

Table reminders {
  id uuid [pk]
  user_id uuid [not null]
  title varchar(255) [not null]
  description text
  reminder_date date [not null]
  reminder_time time
  status varchar(20) [not null, default: 'PENDING']
  priority varchar(10) [not null, default: 'MEDIUM']
  category varchar(100)
  send_email boolean [not null, default: false]
  send_sms boolean [not null, default: false]
  early_alert_sent boolean [not null, default: false]
  alert_sent boolean [not null, default: false]
  notified_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table alerts {
  id uuid [pk]
  recipient_id uuid [not null]
  title varchar(255) [not null]
  message text
  alert_type varchar(50) [not null]
  reference_id uuid
  reference_type varchar(50)
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table audit_logs {
  id uuid [pk]
  entity_type varchar(50) [not null]
  entity_id uuid
  action varchar(30) [not null]
  summary text
  performed_by uuid [not null]
  performed_by_email varchar(255)
  performed_by_role varchar(20)
  ip_address varchar(45)
  created_at timestamp [not null, default: `now()`]
}

Table ip_whitelist {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  ip_address varchar(45) [not null]
  created_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, ip_address) [unique]
  }
}

Table whitelist_config {
  id integer [pk, default: 1]
  enabled boolean [not null, default: true]
  updated_at timestamp [not null, default: `now()`]
}

Table code_sequence {
  code varchar(20) [pk]
}

Table fiscal_years {
  id uuid [pk, default: `gen_random_uuid()`]
  year integer [unique, not null]
  name varchar(50) [not null]
  start_date date [not null]
  end_date date [not null]
  is_closed boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table accounting_periods {
  id uuid [pk, default: `gen_random_uuid()`]
  fiscal_year_id uuid [not null]
  month integer [not null]
  year integer [not null]
  status period_status [not null, default: 'OPEN']
  opened_at timestamp
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (fiscal_year_id, month) [unique, name: 'uq_accounting_period_year_month']
  }
}

Table accounting_period_audit {
  id uuid [pk, default: `gen_random_uuid()`]
  period_id uuid [not null]
  action varchar(50) [not null]
  old_status period_status
  new_status period_status [not null]
  reason varchar(255)
  changed_by uuid
  changed_at timestamp [not null, default: `now()`]
  fiscal_year integer [not null]
  month integer [not null]
  year integer [not null]
}

Table accounting_period_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  period_id uuid [not null]
  fiscal_year integer [not null]
  month integer [not null]
  year integer [not null]
  transaction_type varchar(50) [not null]
  debit decimal(15,2) [not null, default: 0]
  credit decimal(15,2) [not null, default: 0]
  reference_id uuid
  reference_type varchar(50)
  description varchar(500)
  recorded_by uuid [not null]
  recorded_at timestamp [not null, default: `now()`]
}

Table customer_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  order_id uuid
  payment_id uuid
  return_id uuid
  transaction_type varchar(50) [not null]
  debit decimal(12,2) [default: 0]
  credit decimal(12,2) [default: 0]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (customer_id, created_at) [name: 'idx_customer_ledger_customer_date']
  }
}

Table customer_balance_cache {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [unique, not null]
  last_ledger_entry_id uuid
  balance decimal(12,2) [not null, default: 0]
  updated_at timestamp [not null, default: `now()`]
}

Table supplier_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  supplier_id uuid [not null]
  purchase_order_id uuid
  expense_id uuid
  supplier_payment_id uuid
  transaction_type varchar(50) [not null]
  debit decimal(12,2) [default: 0]
  credit decimal(12,2) [default: 0]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (supplier_id, created_at) [name: 'idx_supplier_ledger_supplier_date']
  }
}

Table supplier_balance_cache {
  id uuid [pk, default: `gen_random_uuid()`]
  supplier_id uuid [unique, not null]
  last_ledger_entry_id uuid
  balance decimal(12,2) [not null, default: 0]
  updated_at timestamp [not null, default: `now()`]
}

Table agent_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null]
  commission_id uuid
  payout_id uuid
  transaction_type varchar(50) [not null]
  debit decimal(12,2) [default: 0]
  credit decimal(12,2) [default: 0]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (agent_id, created_at) [name: 'idx_agent_ledger_agent_date']
  }
}

Table agent_balance_cache {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [unique, not null]
  last_ledger_entry_id uuid
  balance decimal(12,2) [not null, default: 0]
  updated_at timestamp [not null, default: `now()`]
}

Table shedlock {
  name varchar(64) [pk]
  lock_until timestamp [not null]
  locked_at timestamp [not null]
  locked_by varchar(255) [not null]
}

Ref: agents.user_id > users.id
Ref: orders.agent_id > agents.id
Ref: orders.customer_id > customers.id
Ref: orders.created_by > users.id
Ref: orders.delivery_assigned_to > users.id
Ref: orders.trip_id > delivery_trips.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_items.combo_id > combos.id
Ref: addresses.customer_id > customers.id
Ref: inventory.product_id > products.id
Ref: stock.inventory_id > inventory.id
